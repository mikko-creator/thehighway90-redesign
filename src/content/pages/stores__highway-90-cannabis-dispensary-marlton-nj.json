   {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
     {
      "@type": "Question",
      "name": "Where is Highway 90 located?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "Highway 90 Dispensary is located at 90 Old Marlton Pike W., Marlton NJ. 08053 We are easily accessible to customers in the area, offering a wide range of high-quality products including flower, edibles, pre-rolls, vapes concentrates, and more. Visit us during our operating hours to explore what we have to offer!"
      }
     },
     {
      "@type": "Question",
      "name": "What are the operating hours of Highway 90?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "Highway 90 is open the following hours for your convenience:Monday &#8211; Sunday 9am-10pm"
      }
     },
     {
      "@type": "Question",
      "name": "Do I need a medical card to purchase products at Highway 90?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "No, we serve recreational customers. A valid ID showing you are 21+ is required for recreational purchases."
      }
     },
     {
      "@type": "Question",
      "name": "Can I place an order online for pickup?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "Yes, you can browse our product selection and place an order online for quick and easy pickup. Online ordering has a cutoff time of 9:30pm and orders are NOT held overnight."
      }
     },
     {
      "@type": "Question",
      "name": "What types of cannabis products does Highway 90 offer?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "We offer a wide range of high-quality products including Flower, Edibles, Pre-rolls, Vapes and Concentrates as well as top brands. Visit us during our operating hours to explore what we have to offer!"
      }
     },
     {
      "@type": "Question",
      "name": "Are Highway 90's products lab-tested for quality and safety?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "Yes, all our products undergo rigorous testing to ensure they meet the highest quality and safety standards"
      }
     },
     {
      "@type": "Question",
      "name": "Can Highway 90 give me recommendations on which products to choose?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "Absolutely! Our knowledgeable staff is here to provide guidance and answer any questions you may have about cannabis products."
      }
     }
    ]
   }
